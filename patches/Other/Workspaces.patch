+    private TabModel getModel() {
+        return mTabModelSelector.getModel(/* incognito= */ false);
+    }
+
+    private void onTabSelected(Tab tab, @TabSelectionType int type, int lastId) {
+        if (!Workspaces.isEnabled() || tab.isIncognito() || mSelecting) return;
+        String workspace = Workspaces.getWorkspaceOfTab(tab.getId());
+        if (!workspace.equals(Workspaces.getActiveId())) {
+            // Chrome picks a neighbour of a closed tab, which may belong to another workspace.
+            // Closing a tab should not carry the user out of the workspace they are in.
+            if (type == TabSelectionType.FROM_CLOSE && keepSelectionInActiveWorkspace()) return;
+            // Otherwise the tab was chosen deliberately -- from the tab switcher, a link from
+            // another app -- and the workspace follows it.
+            Workspaces.setActiveId(workspace);
+        }
+        Workspaces.noteSelectedTab(tab.getId());
+    }
+
+    /**
+     * Moves the selection to the tab of the current workspace nearest the current one, or, when the
+     * workspace has just lost its last tab, gives it a new one.
+     */
+    private boolean keepSelectionInActiveWorkspace() {
+        TabModel model = getModel();
+        String active = Workspaces.getActiveId();
+        int current = model.index();
+        Tab best = null;
+        int bestDistance = Integer.MAX_VALUE;
+        for (int i = 0; i < model.getCount(); i++) {
+            Tab candidate = model.getTabAt(i);
+            if (candidate == null || candidate.isClosing()) continue;
+            if (!Workspaces.getWorkspaceOfTab(candidate.getId()).equals(active)) continue;
+            int distance = Math.abs(i - current);
+            if (distance < bestDistance) {
+                best = candidate;
+                bestDistance = distance;
+            }
+        }
+        if (best != null) {
+            select(best);
+            return true;
+        }
+        openNewTab();
+        return true;
+    }
+
+    private void select(Tab tab) {
+        TabModel model = getModel();
+        int index = model.indexOf(tab);
+        if (index < 0) return;
+        mSelecting = true;
+        try {
+            model.setIndex(index, TabSelectionType.FROM_USER);
+        } finally {
+            mSelecting = false;
+        }
+        Workspaces.noteSelectedTab(tab.getId());
+    }
+
+    private void openNewTab() {
+        // The new tab joins the current workspace as it is created (see TabImpl).
+        TabCreatorUtil.launchNtp(getModel().getTabCreator());
+    }
+
+    /** The tabs of {@code workspaceId}, in strip order. */
+    private List<Tab> getTabs(String workspaceId) {
+        TabModel model = getModel();
+        List<Tab> tabs = new ArrayList<>();
+        for (int i = 0; i < model.getCount(); i++) {
+            Tab tab = model.getTabAt(i);
+            if (tab == null || tab.isClosing()) continue;
+            if (Workspaces.getWorkspaceOfTab(tab.getId()).equals(workspaceId)) tabs.add(tab);
+        }
+        return tabs;
+    }
+
+    /** Makes {@code workspaceId} current and shows the tab last used there. */
+    public void switchTo(String workspaceId) {
+        if (workspaceId.equals(Workspaces.getActiveId())) return;
+        Workspaces.setActiveId(workspaceId);
+        List<Tab> tabs = getTabs(workspaceId);
+        if (tabs.isEmpty()) {
+            openNewTab();
+            return;
+        }
+        Workspace workspace = Workspaces.get(workspaceId);
+        Tab target = tabs.get(0);
+        if (workspace != null) {
+            for (Tab tab : tabs) {
+                if (tab.getId() == workspace.lastTabId) target = tab;
+            }
+        }
+        select(target);
+    }
+
+    private void createWorkspace() {
+        switchTo(Workspaces.create(/* name= */ null).id);
+    }
+
+    /**
+     * Moves {@code tabs} into workspace {@code workspaceId}, and their pages into its storage. A tab
+     * leaves its group unless the whole group goes with it. The workspace on screen stays: if the
+     * selected tab went, the selection moves to the nearest tab left.
+     */
+    public void moveTabsToWorkspace(List<Tab> tabs, String workspaceId) {
+        TabModel model = getModel();
+        List<Tab> moving = new ArrayList<>();
+        for (Tab tab : tabs) {
+            if (!tab.isClosing() && !tab.isIncognito() && model.indexOf(tab) >= 0) moving.add(tab);
+        }
+        if (moving.isEmpty() || Workspaces.get(workspaceId) == null) return;
+
+        List<Tab> leavingGroups = new ArrayList<>();
+        for (Tab tab : moving) {
+            Token groupId = tab.getTabGroupId();
+            if (groupId != null && !moving.containsAll(model.getTabsInGroup(groupId))) {
+                leavingGroups.add(tab);
+            }
+        }
+        if (!leavingGroups.isEmpty()) {
+            model.getTabUngrouper()
+                    .ungroupTabs(leavingGroups, /* trailing= */ true, /* allowDialog= */ false);
+        }
+
+        Tab selected = model.getTabAt(model.index());
+        for (Tab tab : moving) Workspaces.setWorkspaceOfTab(tab.getId(), workspaceId);
+        if (selected != null
+                && moving.contains(selected)
+                && !workspaceId.equals(Workspaces.getActiveId())) {
+            keepSelectionInActiveWorkspace();
+        }
+        // Once out of sight, so the pages are rebuilt without being shown.
+        for (Tab tab : moving) TabUtils.moveToWorkspaceStorage(tab);
+    }
+
+    /**
+     * The tab menu's "Move to workspace" entry for {@code tabs}, with the other workspaces and a
