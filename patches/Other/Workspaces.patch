+    private void setSeparateStorage(String workspaceId, boolean separate) {
+        Workspace workspace = Workspaces.get(workspaceId);
+        if (workspace == null || workspace.separateStorage == separate) return;
+        Workspaces.setSeparateStorage(workspaceId, separate);
