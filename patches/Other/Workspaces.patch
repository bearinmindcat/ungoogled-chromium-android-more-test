+// A workspace's tabs keep their cookies and site data in a partition named
+// after the workspace, so being signed in to a site in one workspace says
+// nothing about any other. The partition is persistent and fixed for the
+// WebContents' lifetime: it carries across navigations and is what a restored
+// tab is rebuilt in (see WebContentsState, which uses the same domain).
+static ScopedJavaLocalRef<jobject>
+JNI_WebContentsFactory_CreateWebContentsInPartition(
+    JNIEnv* env,
+    Profile* profile,
+    const std::string& partition_name,
+    bool initially_hidden,
+    bool initialize_renderer,
+    const JavaRef<jthrowable>& j_creator_location) {
+  auto partition_config = content::StoragePartitionConfig::Create(
+      profile, kWorkspacePartitionDomain, partition_name, /*in_memory=*/false);
+  // Start from about:blank, as a <webview> guest does, so the first
+  // SiteInstance is a well-formed one in the workspace partition.
+  auto site_instance = content::SiteInstance::CreateForFixedStoragePartition(
+      profile, GURL(url::kAboutBlankURL), partition_config);
+
+  content::WebContents::CreateParams params(profile, std::move(site_instance));
+  params.initially_hidden = initially_hidden;
+  params.desired_renderer_state =
+      initialize_renderer
+          ? content::WebContents::CreateParams::
+                kInitializeAndWarmupRendererProcess
+          : content::WebContents::CreateParams::kOkayToHaveRendererProcess;
+  params.java_creator_location = j_creator_location;
+
+  // Ownership is passed into java, and then to TabAndroid::InitWebContents.
+  return content::WebContents::Create(params).release()->GetJavaWebContents();
+}
+
+// The workspace partition `web_contents` keeps its storage in, or an empty
+// string when it uses the profile's own.
+static std::string JNI_WebContentsFactory_GetWorkspacePartition(
+    JNIEnv* env,
+    content::WebContents* web_contents) {
+  const content::StoragePartitionConfig& config =
+      web_contents->GetSiteInstance()
+          ->GetSecurityPrincipal()
+          .GetStoragePartitionConfig();
+  return config.partition_domain() == kWorkspacePartitionDomain
+             ? config.partition_name()
+             : std::string();
+}
+
+// Deletes everything a workspace kept in its partition -- cookies, site data
+// and caches -- and then the partition's directory, once the workspace is
+// gone. content keeps a partition's directory for good, so it is removed here,
+// as Brave does for its containers.
+static void JNI_WebContentsFactory_ClearWorkspacePartition(
+    JNIEnv* env,
+    Profile* profile,
+    const std::string& partition_name) {
+  base::FilePath path = GetWorkspacePartitionPath(profile, partition_name);
+  content::StoragePartition* partition = profile->GetStoragePartition(
+      content::StoragePartitionConfig::Create(
+          profile, kWorkspacePartitionDomain, partition_name,
+          /*in_memory=*/false),
+      /*can_create=*/false);
+  if (!partition) {
+    DeleteWorkspacePartitionDirectory(path);
+    return;
+  }
+  DCHECK_EQ(partition->GetPath(), path);
+
+  // The directory goes once both clears are done.
+  base::RepeatingClosure cleared = base::BarrierClosure(
+      2, base::BindOnce(&DeleteWorkspacePartitionDirectory, path));
+  // An empty StorageKey has an opaque origin, which clears every origin.
+  partition->ClearData(content::StoragePartition::REMOVE_DATA_MASK_ALL,
+                       blink::StorageKey(), base::Time(), base::Time::Max(),
+                       cleared);
+  partition->GetNetworkContext()->ClearHttpCache(
+      base::Time(), base::Time::Max(), /*filter=*/nullptr, cleared);
+}
