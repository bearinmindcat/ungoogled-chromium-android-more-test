+    /** Shows the workspace menu anchored to {@code anchor}. */
+    public void showMenu(RectProvider anchor) {
+        if (mMenuWindow != null && mMenuWindow.isShowing()) return;
+        Context context = mActivity;
+        ModelList modelList = new ModelList();
+        buildMenu(modelList);
