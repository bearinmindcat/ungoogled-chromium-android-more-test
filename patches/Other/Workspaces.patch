+    /**
+     * The colours a space can take: the browser's own theme colours, the new tab page's Chrome
+     * colors, drawn and picked by that picker's adapter, as the desktop build offers Customize
+     * Chrome's. The first, the default palette, stands for no colour. The items are a size down
+     * from the new tab page's, so all ten fit in two rows.
+     */
+    private RecyclerView createColorGrid(int selectedColor, Callback<Integer> onColorPicked) {
+        Context context = mActivity;
+        List<NtpThemeColorInfo> colorInfos = new ArrayList<>();
+        List<Integer> colors = new ArrayList<>();
+        NtpThemeColorInfo noColor = new NtpThemeColorInfo(context, NtpThemeColorId.DEFAULT);
+        noColor.colorStringResId = R.string.workspace_no_color;
+        colorInfos.add(noColor);
+        colors.add(Workspaces.NO_COLOR);
+        for (int id = NtpThemeColorId.DEFAULT + 1; id < NtpThemeColorId.NUM_ENTRIES; id++) {
+            colorInfos.add(new NtpThemeColorInfo(context, id));
+            colors.add(id);
+        }
+
+        int itemSize = ViewUtils.dpToPx(context, COLOR_ITEM_SIZE_DP);
+        int circleSize = ViewUtils.dpToPx(context, COLOR_CIRCLE_SIZE_DP);
+        int margin = ViewUtils.dpToPx(context, COLOR_ITEM_MARGIN_DP);
+        int cellWidth = itemSize + 2 * margin;
+        GridLayoutManager layoutManager = new GridLayoutManager(context, 1);
+        RecyclerView grid =
+                new RecyclerView(context) {
+                    @Override
+                    protected void onMeasure(int widthSpec, int heightSpec) {
+                        // As many to a row as fit, the grid as wide as its rows, as on the new
+                        // tab page.
+                        int width = MeasureSpec.getSize(widthSpec);
+                        if (width > 0) {
+                            int spanCount = Math.max(1, width / cellWidth);
+                            if (layoutManager.getSpanCount() != spanCount) {
+                                layoutManager.setSpanCount(spanCount);
+                            }
+                            widthSpec =
+                                    MeasureSpec.makeMeasureSpec(
+                                            spanCount * cellWidth, MeasureSpec.EXACTLY);
+                        }
+                        super.onMeasure(widthSpec, heightSpec);
+                    }
+                };
+        grid.setLayoutManager(layoutManager);
+        grid.setNestedScrollingEnabled(false);
+        grid.setAdapter(
+                new NtpChromeColorsAdapter(
+                        context,
+                        colorInfos,
+                        info -> onColorPicked.onResult(colors.get(colorInfos.indexOf(info))),
+                        Math.max(0, colors.indexOf(selectedColor))) {
+                    @Override
+                    public ColorViewHolder onCreateViewHolder(ViewGroup parent, int viewType) {
+                        ColorViewHolder holder = super.onCreateViewHolder(parent, viewType);
+                        ViewGroup.MarginLayoutParams params =
+                                (ViewGroup.MarginLayoutParams) holder.itemView.getLayoutParams();
+                        params.width = itemSize;
+                        params.height = itemSize;
+                        params.setMargins(margin, margin, margin, margin);
+                        ViewGroup.LayoutParams circle =
+                                holder.itemView.findViewById(R.id.color_circle).getLayoutParams();
+                        circle.width = circleSize;
+                        circle.height = circleSize;
+                        return holder;
+                    }
+                });
+        LinearLayout.LayoutParams params =
+                new LinearLayout.LayoutParams(
+                        LinearLayout.LayoutParams.WRAP_CONTENT,
+                        LinearLayout.LayoutParams.WRAP_CONTENT);
+        params.gravity = Gravity.CENTER_HORIZONTAL;
+        grid.setLayoutParams(params);
+        return grid;
+    }
