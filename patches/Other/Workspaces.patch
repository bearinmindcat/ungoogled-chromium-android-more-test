+                        if (buttonType == ModalDialogProperties.ButtonType.POSITIVE) {
+                            Workspaces.rename(workspaceId, name.getText().toString());
+                            Workspaces.setColor(workspaceId, chosenColor[0]);
+                            setSeparateStorage(workspaceId, storage.isChecked());
+                            mModalDialogManager.dismissDialog(
