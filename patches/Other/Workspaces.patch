+// The domain of the StoragePartitions workspaces keep their tabs' storage in,
+// each named after its workspace. WebContentsState and the browsing data
+// remover use the same.
+constexpr char kWorkspacePartitionDomain[] = "workspace";
+
+// Where content keeps the partition `partition_name`: the layout of
+// StoragePartitionImplMap::GetStoragePartitionPath(), which is internal to
+// content. Computed rather than asked for, so a partition that isn't loaded is
+// never created only to be deleted.
+base::FilePath GetWorkspacePartitionPath(Profile* profile,
+                                         const std::string& partition_name) {
+  constexpr size_t kPartitionNameHashBytes = 6;
+  auto hash = crypto::hash::Sha256(partition_name);
+  return profile->GetPath()
+      .AppendASCII("Storage")
+      .AppendASCII("ext")
+      .AppendASCII(kWorkspacePartitionDomain)
+      .AppendASCII(
+          base::HexEncode(base::span(hash).first<kPartitionNameHashBytes>()));
+}
+
+void DeleteWorkspacePartitionDirectory(const base::FilePath& path) {
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::GetDeletePathRecursivelyCallback(path));
+}
