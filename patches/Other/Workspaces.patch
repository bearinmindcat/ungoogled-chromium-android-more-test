+    private void showDeleteDialog(String workspaceId) {
+        Workspace workspace = Workspaces.get(workspaceId);
+        if (workspace == null || Workspaces.DEFAULT_ID.equals(workspaceId)) return;
+        Context context = mActivity;
+        int tabCount = getTabs(workspaceId).size();
+        String message =
+                tabCount == 1
+                        ? context.getString(R.string.workspace_delete_message_one)
+                        : context.getString(R.string.workspace_delete_message_many, tabCount);
+        ModalDialogProperties.Controller controller =
+                new ModalDialogProperties.Controller() {
+                    @Override
+                    public void onClick(PropertyModel model, int buttonType) {
+                        if (buttonType == ModalDialogProperties.ButtonType.POSITIVE) {
+                            deleteWorkspace(workspaceId);
+                            mModalDialogManager.dismissDialog(
+                                    model, DialogDismissalCause.POSITIVE_BUTTON_CLICKED);
+                        } else {
+                            mModalDialogManager.dismissDialog(
+                                    model, DialogDismissalCause.NEGATIVE_BUTTON_CLICKED);
+                        }
+                    }
+
+                    @Override
+                    public void onDismiss(PropertyModel model, int dismissalCause) {}
+                };
+        PropertyModel model =
+                new PropertyModel.Builder(ModalDialogProperties.ALL_KEYS)
+                        .with(ModalDialogProperties.CONTROLLER, controller)
+                        .with(
+                                ModalDialogProperties.TITLE,
+                                context.getString(R.string.workspace_delete_title, workspace.name))
+                        .with(ModalDialogProperties.MESSAGE_PARAGRAPH_1, message)
+                        .with(
+                                ModalDialogProperties.POSITIVE_BUTTON_TEXT,
+                                context.getString(R.string.workspace_delete_confirm))
+                        .with(
+                                ModalDialogProperties.NEGATIVE_BUTTON_TEXT,
+                                context.getString(R.string.cancel))
+                        .with(
+                                ModalDialogProperties.BUTTON_STYLES,
+                                ModalDialogProperties.ButtonStyles.PRIMARY_FILLED_NEGATIVE_OUTLINE)
+                        .build();
+        mModalDialogManager.showDialog(model, ModalDialogType.APP);
+    }
+
+    private void deleteWorkspace(String workspaceId) {
+        List<Tab> tabs = getTabs(workspaceId);
+        // Leave the workspace before its tabs go, so closing them does not pull the selection
+        // around inside it.
+        if (workspaceId.equals(Workspaces.getActiveId())) switchTo(Workspaces.DEFAULT_ID);
+        if (!tabs.isEmpty()) {
+            getModel()
+                    .getTabRemover()
+                    .closeTabs(
+                            TabClosureParams.closeTabs(tabs).allowUndo(false).build(),
+                            /* allowDialog= */ false);
+        }
+        if (!Workspaces.delete(workspaceId)) return;
+        // What the workspace stored goes with it.
+        Profile profile = getModel().getProfile();
+        if (profile != null) WebContentsFactory.clearWorkspacePartition(profile, workspaceId);
+    }
