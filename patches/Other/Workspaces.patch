+                createAdapter(
+                        modelList,
+                        Set.of(),
+                        (model, view) -> {
+                            if (mMenuWindow != null) mMenuWindow.dismiss();
+                            View.OnClickListener listener = model.get(CLICK_LISTENER);
+                            if (listener != null) listener.onClick(view);
+                        });
+        listView.setItemsCanFocus(true);
+        listView.setAdapter(adapter);
+
+        int[] contentDimensions = UiUtils.computeListAdapterContentDimensions(adapter, listView);
+        int minWidthPx =
+                context.getResources().getDimensionPixelSize(R.dimen.tab_strip_context_menu_min_width);
+        int maxWidthPx =
+                context.getResources().getDimensionPixelSize(R.dimen.tab_strip_context_menu_max_width);
