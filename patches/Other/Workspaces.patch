+package org.chromium.chrome.browser.ui.vertical_tabs;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JniType;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.ObserverList;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+/**
+ * Workspaces: sets of tabs shown to the exclusion of the others, one of them current at a time.
+ * Switching workspace changes which tabs the strip and the rail show.
+ *
+ * <p>A workspace is not a tab group. Membership is a side table keyed on the tab id -- stable for
+ * the life of the tab and across restarts -- so a tab can sit in a workspace, a group and a stack
+ * at once, the way Vivaldi keeps its workspace id apart from Chromium's grouping.
+ *
+ * <p>A workspace can keep its own storage: tabs created in it then get a storage partition of
+ * their own, so cookies, logins and site data do not cross between workspaces. A partition is
+ * fixed when a tab's WebContents is created, so switching the setting rebuilds the pages already
+ * open in the workspace (see TabImpl#moveToWorkspaceStorage).
+ *
+ * <p>Only the regular tabs of the tabbed browser take part; incognito and custom tabs never do.
+ */
+@NullMarked
+public final class Workspaces {
+    /**
+     * The workspace every tab starts in. It always exists, and uses the profile's own storage
+     * unless isolated like any other.
+     */
+    public static final String DEFAULT_ID = "default";
+
+    /**
+     * A workspace with no colour of its own. The others take one of the browser's theme colours,
+     * the new tab page's Chrome colors, by its NtpThemeColorId.
+     */
+    public static final int NO_COLOR = -1;
+
+    /** One workspace's durable record. */
+    public static final class Workspace {
+        public final String id;
+        public String name;
+        // A Chrome color's NtpThemeColorId, or NO_COLOR.
+        public int color;
+        public boolean separateStorage;
+        // The tab last selected here, so switching back lands where the user left off.
+        public int lastTabId;
+
+        Workspace(String id, String name, int color, boolean separateStorage, int lastTabId) {
+            this.id = id;
+            this.name = name;
+            this.color = color;
+            this.separateStorage = separateStorage;
+            this.lastTabId = lastTabId;
+        }
+    }
+
+    // The desktop build's word for them; new ones are "Space 2", "Space 3" and so on.
+    private static final String DEFAULT_NAME = "Space";
+    // What earlier builds named them; names they generated are renamed on load.
+    private static final String OLD_DEFAULT_NAME = "Workspace";
+    private static final int INVALID_TAB_ID = -1;
+    // By TabGroupColorId: grey has no Chrome color; blue, red, yellow, green, pink, purple, cyan
+    // and orange become Blue, Rose, Citron, Green, Fuchsia, Violet, Aqua and Orange.
+    private static final int[] TAB_GROUP_COLOR_TO_THEME_COLOR = {NO_COLOR, 1, 7, 5, 3, 8, 9, 2, 6};
+
+    private static final ObserverList<Runnable> sObservers = new ObserverList<>();
+    private static @Nullable List<Workspace> sWorkspaces;
+    private static @Nullable Map<Integer, String> sTabToWorkspace;
+    private static @Nullable String sActiveId;
+
+    private Workspaces() {}
+
+    /** Whether workspaces are switched on in Settings > Experimental > Tabs. */
+    public static boolean isEnabled() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.WORKSPACES_ENABLED, true);
+    }
+
+    /** Told whenever the set of workspaces, their records, the current one or membership change. */
+    public static void addObserver(Runnable observer) {
+        sObservers.addObserver(observer);
+    }
+
+    public static void removeObserver(Runnable observer) {
+        sObservers.removeObserver(observer);
+    }
+
+    /** All workspaces, in the order they were created. There is always at least one. */
+    public static List<Workspace> getAll() {
+        return new ArrayList<>(workspaces());
+    }
+
+    public static @Nullable Workspace get(String id) {
+        for (Workspace workspace : workspaces()) {
+            if (workspace.id.equals(id)) return workspace;
+        }
+        return null;
+    }
+
+    /** The current workspace's id. */
+    public static String getActiveId() {
+        if (sActiveId == null) {
+            String stored =
+                    ChromeSharedPreferences.getInstance()
+                            .readString(ChromePreferenceKeys.WORKSPACES_ACTIVE, DEFAULT_ID);
+            sActiveId = stored != null && get(stored) != null ? stored : DEFAULT_ID;
+        }
+        return sActiveId;
+    }
+
+    public static Workspace getActive() {
+        Workspace active = get(getActiveId());
+        return active != null ? active : workspaces().get(0);
+    }
+
+    /** Makes {@code id} current. Choosing which tab to show is the caller's business. */
+    public static void setActiveId(String id) {
+        if (get(id) == null || id.equals(getActiveId())) return;
+        sActiveId = id;
+        ChromeSharedPreferences.getInstance().writeString(ChromePreferenceKeys.WORKSPACES_ACTIVE, id);
+        notifyObservers();
+    }
+
+    /** The workspace {@code tabId} belongs to. Tabs never assigned belong to the default one. */
+    public static String getWorkspaceOfTab(int tabId) {
+        String id = tabs().get(tabId);
+        return id != null && get(id) != null ? id : DEFAULT_ID;
+    }
+
+    /** Whether {@code tabId} has been given a workspace, as opposed to defaulting to one. */
+    public static boolean isTabAssigned(int tabId) {
+        return tabs().containsKey(tabId);
+    }
+
+    /** Moves {@code tabId} into workspace {@code id}. */
+    public static void setWorkspaceOfTab(int tabId, String id) {
+        if (get(id) == null || id.equals(tabs().get(tabId))) return;
+        tabs().put(tabId, id);
+        saveTabs();
+        notifyObservers();
+    }
+
+    /** Drops a tab that has been closed for good. */
+    public static void forgetTab(int tabId) {
+        if (tabs().remove(tabId) != null) saveTabs();
+    }
+
+    /** Drops every recorded tab not in {@code liveTabIds}, once the tab model has restored. */
+    public static void retainTabs(Collection<Integer> liveTabIds) {
+        if (tabs().keySet().retainAll(liveTabIds)) saveTabs();
+    }
+
+    /** Whether {@code tabId} belongs to a workspace other than the current one. */
+    public static boolean isTabHidden(int tabId) {
+        if (!isEnabled() || workspaces().size() < 2) return false;
+        return !getWorkspaceOfTab(tabId).equals(getActiveId());
+    }
+
+    /**
+     * Records the workspace of a tab being created and returns the storage partition its page
+     * should live in. A new tab joins its parent's workspace -- a link opened from a tab stays with
+     * it -- and otherwise the current one; a restored tab keeps the workspace it already had.
+     *
+     * @return The partition name, or null for the profile's own storage.
+     */
+    public static @Nullable String onTabCreated(int tabId, int parentId, boolean isRestore) {
+        if (!isEnabled()) return null;
+        if (!isRestore && !isTabAssigned(tabId)) {
+            String workspace =
+                    parentId != INVALID_TAB_ID && isTabAssigned(parentId)
+                            ? getWorkspaceOfTab(parentId)
+                            : getActiveId();
+            tabs().put(tabId, workspace);
+            saveTabs();
+        }
+        return getPartitionForTab(tabId);
+    }
+
+    /** The storage partition {@code tabId}'s page lives in, or null for the profile's own. */
+    public static @Nullable String getPartitionForTab(int tabId) {
+        if (!isEnabled()) return null;
+        Workspace workspace = get(getWorkspaceOfTab(tabId));
+        return workspace != null && workspace.separateStorage ? workspace.id : null;
+    }
+
+    /**
+     * The storage partitions browsing data is also cleared from. Every workspace may have one,
+     * named after it: what a workspace stored while isolated stays there after that is turned off.
+     */
+    @CalledByNative
+    private static @JniType("std::vector<std::string>") List<String> getStoragePartitions() {
+        List<String> partitions = new ArrayList<>();
+        for (Workspace workspace : workspaces()) partitions.add(workspace.id);
+        return partitions;
+    }
+
+    /** Creates a workspace with separate storage, as new workspaces have by default. */
+    public static Workspace create(@Nullable String name) {
+        String title = name == null || name.trim().isEmpty() ? nextDefaultName() : name.trim();
+        Workspace workspace =
+                new Workspace(
+                        UUID.randomUUID().toString(),
+                        title,
+                        NO_COLOR,
+                        /* separateStorage= */ true,
+                        INVALID_TAB_ID);
+        workspaces().add(workspace);
+        saveWorkspaces();
+        notifyObservers();
+        return workspace;
+    }
+
+    public static void rename(String id, String name) {
+        Workspace workspace = get(id);
+        if (workspace == null || name.trim().isEmpty()) return;
+        workspace.name = name.trim();
+        saveWorkspaces();
+        notifyObservers();
+    }
+
+    public static void setColor(String id, int color) {
+        Workspace workspace = get(id);
+        if (workspace == null || workspace.color == color) return;
+        workspace.color = color;
+        saveWorkspaces();
+        notifyObservers();
+    }
+
+    public static void setSeparateStorage(String id, boolean separate) {
+        Workspace workspace = get(id);
+        if (workspace == null || workspace.separateStorage == separate) return;
+        workspace.separateStorage = separate;
+        saveWorkspaces();
+        notifyObservers();
+    }
+
+    /** Remembers the tab last selected in {@code tabId}'s workspace. */
+    public static void noteSelectedTab(int tabId) {
+        Workspace workspace = get(getWorkspaceOfTab(tabId));
+        if (workspace == null || workspace.lastTabId == tabId) return;
+        workspace.lastTabId = tabId;
+        saveWorkspaces();
+    }
+
+    /**
+     * Deletes workspace {@code id}; the caller closes its tabs. The default workspace cannot be
+     * deleted, and neither can the last one standing.
+     */
+    public static boolean delete(String id) {
+        if (DEFAULT_ID.equals(id) || workspaces().size() < 2) return false;
+        Workspace workspace = get(id);
+        if (workspace == null) return false;
+        workspaces().remove(workspace);
+        tabs().values().removeIf(id::equals);
+        if (id.equals(getActiveId())) {
+            sActiveId = DEFAULT_ID;
+            ChromeSharedPreferences.getInstance()
+                    .writeString(ChromePreferenceKeys.WORKSPACES_ACTIVE, DEFAULT_ID);
+        }
+        saveWorkspaces();
+        saveTabs();
+        notifyObservers();
+        return true;
+    }
+
+    /** The ids of {@code workspaceId}'s tabs among {@code tabIds}, in the order given. */
+    public static List<Integer> filterTabs(List<Integer> tabIds, String workspaceId) {
+        List<Integer> result = new ArrayList<>();
+        for (int tabId : tabIds) {
+            if (getWorkspaceOfTab(tabId).equals(workspaceId)) result.add(tabId);
+        }
+        return result;
+    }
+
+    private static String nextDefaultName() {
+        int suffix = workspaces().size() + 1;
+        while (true) {
+            String candidate = DEFAULT_NAME + " " + suffix;
+            boolean taken = false;
+            for (Workspace workspace : workspaces()) {
+                if (workspace.name.equals(candidate)) taken = true;
+            }
+            if (!taken) return candidate;
+            suffix++;
+        }
+    }
+
+    private static void notifyObservers() {
+        for (Runnable observer : sObservers) observer.run();
+    }
+
+    private static List<Workspace> workspaces() {
+        if (sWorkspaces == null) {
+            sWorkspaces = loadWorkspaces();
+            boolean hasDefault = false;
+            for (Workspace workspace : sWorkspaces) {
+                if (DEFAULT_ID.equals(workspace.id)) hasDefault = true;
+            }
+            if (!hasDefault) {
+                sWorkspaces.add(
+                        0,
+                        new Workspace(
+                                DEFAULT_ID,
+                                DEFAULT_NAME,
+                                NO_COLOR,
+                                /* separateStorage= */ false,
+                                INVALID_TAB_ID));
+            }
+        }
+        return sWorkspaces;
+    }
+
+    private static Map<Integer, String> tabs() {
+        if (sTabToWorkspace == null) sTabToWorkspace = loadTabs();
+        return sTabToWorkspace;
+    }
+
+    private static List<Workspace> loadWorkspaces() {
+        List<Workspace> result = new ArrayList<>();
+        String json =
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.WORKSPACES_LIST, null);
+        if (json == null) return result;
+        try {
+            JSONArray array = new JSONArray(json);
+            for (int i = 0; i < array.length(); i++) {
+                JSONObject item = array.getJSONObject(i);
+                result.add(
+                        new Workspace(
+                                item.getString("id"),
+                                renameOldDefaultName(item.optString("name", DEFAULT_NAME)),
+                                readColor(item),
+                                item.optBoolean("storage", false),
+                                item.optInt("lastTab", INVALID_TAB_ID)));
+            }
+        } catch (JSONException e) {
+            result.clear();
+        }
+        return result;
+    }
+
+    /**
+     * A workspace's Chrome color. Earlier builds stored a tab group colour under "color" instead;
+     * it becomes the Chrome color nearest to it.
+     */
+    private static int readColor(JSONObject item) {
+        if (item.has("theme")) return item.optInt("theme", NO_COLOR);
+        int oldColor = item.optInt("color", NO_COLOR);
+        return oldColor >= 0 && oldColor < TAB_GROUP_COLOR_TO_THEME_COLOR.length
+                ? TAB_GROUP_COLOR_TO_THEME_COLOR[oldColor]
+                : NO_COLOR;
+    }
+
+    /** "Workspace" and "Workspace 2", as earlier builds named them, become "Space", "Space 2". */
+    private static String renameOldDefaultName(String name) {
+        if (name.equals(OLD_DEFAULT_NAME)) return DEFAULT_NAME;
+        String prefix = OLD_DEFAULT_NAME + " ";
+        if (name.startsWith(prefix) && name.substring(prefix.length()).matches("[0-9]+")) {
+            return DEFAULT_NAME + " " + name.substring(prefix.length());
+        }
+        return name;
+    }
+
+    private static void saveWorkspaces() {
+        JSONArray array = new JSONArray();
+        try {
+            for (Workspace workspace : workspaces()) {
+                JSONObject item = new JSONObject();
+                item.put("id", workspace.id);
+                item.put("name", workspace.name);
+                item.put("theme", workspace.color);
+                item.put("storage", workspace.separateStorage);
+                item.put("lastTab", workspace.lastTabId);
+                array.put(item);
+            }
+        } catch (JSONException e) {
+            return;
+        }
+        ChromeSharedPreferences.getInstance()
+                .writeString(ChromePreferenceKeys.WORKSPACES_LIST, array.toString());
+    }
+
+    private static Map<Integer, String> loadTabs() {
+        Map<Integer, String> result = new HashMap<>();
+        String json =
