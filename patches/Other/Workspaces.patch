+ * Drives workspaces for one tabbed window: keeps the selection inside the current workspace,
+ * switches between workspaces, and shows the workspace menu and its dialogs. The strip's workspace
+ * button and the vertical rail's workspace card both open the same menu through {@link #from}.
+ */
+@NullMarked
+public class WorkspaceController {
+    private static final UnownedUserDataKey<WorkspaceController> KEY = new UnownedUserDataKey<>();
