+package org.chromium.chrome.browser.tasks.tab_management.vertical_tabs;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import androidx.core.widget.ImageViewCompat;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.ui.vertical_tabs.VerticalTabUtils;
+import org.chromium.chrome.browser.ui.vertical_tabs.Workspaces;
+import org.chromium.chrome.browser.ui.vertical_tabs.Workspaces.Workspace;
+import org.chromium.chrome.browser.workspaces.WorkspaceController;
+import org.chromium.chrome.tab_ui.R;
+
+/**
+ * The workspace card at the top of the vertical tab rail: the workspace on screen, in its colour,
+ * and the way into the workspace menu. The rail below it shows only that workspace's tabs.
+ */
+@NullMarked
+class WorkspaceRailHeader {
+    private final View mView;
+    private final ImageView mIcon;
+    private final TextView mName;
+    private final View mMenuButton;
+    private final Runnable mWorkspacesObserver = this::update;
+
+    /**
+     * @param container Where the card goes, at the head of the rail.
+     * @param onMenuRequested Opens the workspace menu, anchored to the view it is given.
+     */
+    WorkspaceRailHeader(ViewGroup container, Callback<View> onMenuRequested) {
+        mView =
+                LayoutInflater.from(container.getContext())
+                        .inflate(R.layout.vertical_workspace_header, container, false);
+        mIcon = mView.findViewById(R.id.workspace_icon);
+        mName = mView.findViewById(R.id.workspace_name);
+        mMenuButton = mView.findViewById(R.id.workspace_menu_button);
+        mView.setOnClickListener(v -> onMenuRequested.onResult(mView));
+        mMenuButton.setOnClickListener(v -> onMenuRequested.onResult(mView));
+        container.addView(mView);
+        Workspaces.addObserver(mWorkspacesObserver);
+        update();
+    }
+
+    /** Re-reads the current workspace, and the rail's width for whether there is room for text. */
+    void update() {
+        Context context = mView.getContext();
+        Workspace workspace = Workspaces.getActive();
+        mName.setText(workspace.name);
+        Integer color = WorkspaceController.getSpaceColor(context, workspace.color);
+        ImageViewCompat.setImageTintList(
+                mIcon, color == null ? null : ColorStateList.valueOf(color));
+        // An icon-only rail has room for the workspace glyph and nothing else, like its tab rows.
+        boolean iconOnly = VerticalTabUtils.isIconOnlyRail();
+        mName.setVisibility(iconOnly ? View.GONE : View.VISIBLE);
+        mMenuButton.setVisibility(iconOnly ? View.GONE : View.VISIBLE);
+        mView.setContentDescription(
+                context.getString(R.string.workspaces_title) + ", " + workspace.name);
+    }
+
+    void destroy() {
+        Workspaces.removeObserver(mWorkspacesObserver);
+    }
+}
