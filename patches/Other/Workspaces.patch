+        for (Workspace workspace : Workspaces.getAll()) {
+            if (workspace.id.equals(from)) continue;
+            submenuItems.add(
+                    new ListItemBuilder()
+                            .withTitle(workspace.name)
+                            .withStartIconDrawable(createCheckSpacer())
+                            .withShouldTintIcon(false)
+                            .withIsTextEllipsizedAtEnd(true)
+                            .withClickListener(v -> moveTabsToWorkspace(tabs, workspace.id))
+                            .build());
+        }
+        submenuItems.add(
+                new ListItemBuilder()
+                        .withTitleRes(R.string.workspace_new)
+                        .withStartIconRes(R.drawable.ic_add_24dp)
+                        .withClickListener(
+                                v ->
+                                        moveTabsToWorkspace(
+                                                tabs, Workspaces.create(/* name= */ null).id))
+                        .build());
+        return new ListItemBuilder()
+                .withTitle(
+                        mActivity
+                                .getResources()
+                                .getQuantityString(R.plurals.workspace_move_tabs, tabs.size()))
+                .withSubmenuItems(submenuItems)
+                .build();
+    }
