+    private static final int COLOR_ITEM_MARGIN_DP = 4;
+    private static final int DIALOG_PADDING_DP = 24;
+
+    private final Activity mActivity;
+    private final TabModelSelector mTabModelSelector;
+    private final ModalDialogManager mModalDialogManager;
+    private final TabModelObserver mTabModelObserver;
+    private final ArchivedTabModelOrchestrator.Observer mArchiveObserver =
+            archivedTabModel -> forgetLostTabs();
+    private @Nullable ArchivedTabModelOrchestrator mArchive;
+    private @Nullable AnchoredPopupWindow mMenuWindow;
+    // Set while this controller moves the selection itself, so the observer does not follow it.
+    private boolean mSelecting;
+    private boolean mDestroyed;
+
+    /** The controller serving {@code windowAndroid}'s tabbed window, if workspaces are on. */
+    public static @Nullable WorkspaceController from(WindowAndroid windowAndroid) {
+        return KEY.retrieveDataFromHost(windowAndroid.getUnownedUserDataHost());
+    }
+
+    public WorkspaceController(
+            Activity activity,
+            WindowAndroid windowAndroid,
+            TabModelSelector tabModelSelector,
+            ModalDialogManager modalDialogManager) {
+        mActivity = activity;
+        mTabModelSelector = tabModelSelector;
+        mModalDialogManager = modalDialogManager;
+        KEY.attachToHost(windowAndroid.getUnownedUserDataHost(), this);
+
+        mTabModelObserver =
+                new TabModelObserver() {
+                    @Override
+                    public void didSelectTab(Tab tab, @TabSelectionType int type, int lastId) {
+                        onTabSelected(tab, type, lastId);
+                    }
+
+                    @Override
+                    public void didAddTab(
+                            Tab tab, int type, int creationState, boolean markedForSelection) {
+                        // A tab moved in from elsewhere -- a custom tab opened in the browser,
+                        // or a tab from another window -- joins the workspace on screen. Tabs
+                        // restored at startup are left alone: one never assigned belongs to the
+                        // default workspace, not whichever workspace happens to be current.
+                        if (type == TabLaunchType.FROM_REPARENTING
+                                && !Workspaces.isTabAssigned(tab.getId())) {
+                            Workspaces.setWorkspaceOfTab(tab.getId(), Workspaces.getActiveId());
+                        }
+                    }
+
+                    @Override
+                    public void restoreCompleted() {
+                        syncActiveWithSelectedTab();
+                    }
+
+                    @Override
+                    public void onFinishingTabClosure(Tab tab) {
+                        forgetClosedTab(tab);
+                    }
+
+                    @Override
+                    public void onFinishingTabClosure(Tab tab, int closingSource) {
+                        forgetClosedTab(tab);
+                    }
+                };
+        getModel().addObserver(mTabModelObserver);
+        syncActiveWithSelectedTab();
+        forgetLostTabs();
+    }
+
+    /**
+     * Makes the workspace on screen the selected tab's. The strip and the rail show only the
+     * current workspace's tabs, so if the two ever disagree -- a selection made before this
+     * controller existed -- the tab being looked at would be hidden.
+     */
+    private void syncActiveWithSelectedTab() {
+        if (!Workspaces.isEnabled()) return;
+        TabModel model = getModel();
+        Tab tab = model.getTabAt(model.index());
+        if (tab == null) return;
+        Workspaces.setActiveId(Workspaces.getWorkspaceOfTab(tab.getId()));
+        Workspaces.noteSelectedTab(tab.getId());
+    }
+
+    /**
+     * Drops a closed tab's workspace -- unless the tab was only moved to the archive of inactive
+     * tabs, which restores it under the same id, back into the workspace it left.
+     */
+    private void forgetClosedTab(Tab tab) {
+        TabModel archived =
+                ArchivedTabModelOrchestrator.getForProfile(tab.getProfile().getOriginalProfile())
+                        .getTabModel();
+        if (archived != null && archived.getTabById(tab.getId()) != null) return;
+        Workspaces.forgetTab(tab.getId());
+    }
+
+    /**
+     * Forgets the workspaces of tabs that did not come back after a restart: Chrome does not keep
+     * a new tab page left in the background, for one. The archive of inactive tabs holds tabs that
+     * keep their workspace too, so this waits for it to load. It runs only with a single window, as
+     * the tabs of other windows are not visible from here.
+     */
+    private void forgetLostTabs() {
+        if (mDestroyed || MultiWindowUtils.getInstanceCount(PersistedInstanceType.ANY) > 1) return;
+        Profile profile = getModel().getProfile();
+        if (profile == null) return;
+        ArchivedTabModelOrchestrator archive = mArchive;
+        if (archive == null) {
+            archive = ArchivedTabModelOrchestrator.getForProfile(profile);
+            mArchive = archive;
+        }
+        TabModelSelector archiveSelector = archive.getTabModelSelector();
+        if (archiveSelector == null) {
+            // The archive is set up a little after startup; this runs again once it is.
+            archive.addObserver(mArchiveObserver);
+            return;
+        }
+        archive.removeObserver(mArchiveObserver);
