+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.compositor.overlays.strip;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.chrome.browser.tabmodel.TabModelUtils;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * The user's explicit tab selection: the tabs marked via "Select tab" or by tapping while a
+ * selection is active.
+ *
+ * <p>Kept separate from {@link TabModel}'s multi-selection because the model requires the current
+ * tab in every non-empty selection (TabCollectionTabModelImpl asserts it), while the user's marks
+ * must be free to include or exclude the active tab. {@link #syncToModel} keeps the model's set at
+ * (explicit + current) so the invariant holds; everything user-visible reads the explicit set.
+ */
+@NullMarked
+public class TabSelections {
+    private static final Set<Integer> sExplicit = new LinkedHashSet<>();
+
+    private TabSelections() {}
+
+    /** Returns whether no tab is explicitly selected. */
+    public static boolean isEmpty() {
+        return sExplicit.isEmpty();
+    }
+
+    /** Returns whether {@code tabId} is explicitly selected. */
+    public static boolean contains(int tabId) {
+        return sExplicit.contains(tabId);
+    }
+
+    /** Marks {@code tabs} as selected. */
+    public static void add(List<Tab> tabs) {
+        for (Tab tab : tabs) sExplicit.add(tab.getId());
+    }
+
+    /** Toggles {@code tabId}'s membership. */
+    public static void toggle(int tabId) {
+        if (!sExplicit.remove(tabId)) sExplicit.add(tabId);
+    }
+
+    /** Returns the selected tab ids, in selection order. */
+    public static List<Integer> getIds() {
+        return new ArrayList<>(sExplicit);
+    }
+
+    /** Drops every mark. */
+    public static void clear() {
+        sExplicit.clear();
+    }
+
+    /** Mirrors the explicit set into {@code model}, keeping the model's own invariant intact. */
+    public static void syncToModel(TabModel model) {
+        sExplicit.removeIf(id -> model.getTabById(id) == null);
+        if (sExplicit.isEmpty()) {
+            model.clearMultiSelection(/* notifyObservers= */ true);
+            return;
+        }
+        Set<Integer> target = new HashSet<>(sExplicit);
+        int currentId = TabModelUtils.getCurrentTabId(model);
+        if (currentId != Tab.INVALID_TAB_ID) target.add(currentId);
+        model.clearMultiSelection(/* notifyObservers= */ false);
+        model.setTabsMultiSelected(target, /* isSelected= */ true);
+    }
+}
