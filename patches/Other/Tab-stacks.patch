+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.compositor.overlays.strip;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.tab.Tab;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Tab stacks: several tabs collapsed behind a single entry in the tab strip, Vivaldi style.
+ *
+ * <p>Deliberately not built on tab groups. A collapsed group draws a coloured title chip rather
+ * than one of its tabs, so a group can never present as "the tab you were last looking at", which
+ * is the whole point of a stack.
+ *
+ * <p>Membership is a side table keyed on the tab id, which is stable for the life of the tab and
+ * stays comparable after the tab is gone -- unlike a strip index, which shifts on every reorder.
+ * Storage is deliberately simple for now; it can move behind this same API later.
+ */
+@NullMarked
+public class TabStacks {
+    /** Returned for tabs that are not in any stack. */
+    public static final int NO_STACK = 0;
+
+    private static final Map<Integer, Integer> sTabIdToStackId = new HashMap<>();
+    private static int sNextStackId = 1;
+
+    private TabStacks() {}
+
+    /**
+     * Puts {@code tabs} into a newly created stack, removing them from any stack they were in. A
+     * tab belongs to at most one stack, the same rule Chromium applies to splits.
+     *
+     * @return the id of the new stack.
+     */
+    public static int createStack(List<Tab> tabs) {
+        int stackId = sNextStackId++;
+        for (Tab tab : tabs) {
+            sTabIdToStackId.put(tab.getId(), stackId);
+        }
+        return stackId;
+    }
+
+    /** Returns the stack containing {@code tabId}, or {@link #NO_STACK}. */
+    public static int getStackForTab(int tabId) {
+        Integer stackId = sTabIdToStackId.get(tabId);
+        return stackId == null ? NO_STACK : stackId;
+    }
+
+    /** Returns the tab ids in {@code stackId}, in no particular order. */
+    public static List<Integer> getTabsInStack(int stackId) {
+        List<Integer> tabIds = new ArrayList<>();
+        if (stackId == NO_STACK) return tabIds;
+        for (Map.Entry<Integer, Integer> entry : sTabIdToStackId.entrySet()) {
+            if (entry.getValue() == stackId) tabIds.add(entry.getKey());
+        }
+        return tabIds;
+    }
+
+    /** Returns how many tabs are in {@code stackId}. */
+    public static int getStackSize(int stackId) {
+        return getTabsInStack(stackId).size();
+    }
+
+    /** Forgets a tab, e.g. once it has been closed. */
+    public static void removeTab(int tabId) {
+        sTabIdToStackId.remove(tabId);
+    }
+}
