+package org.chromium.chrome.browser.compositor.overlays.strip;
+
+import android.content.Context;
+
+import androidx.annotation.ColorInt;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.theme.ThemeUtils;
+import org.chromium.components.browser_ui.styles.ChromeColors;
+
+/** Reads the user-selectable tab strip appearance options. */
+@NullMarked
+public class StripLayoutOptions {
+    private StripLayoutOptions() {}
+
+    /** Whether every tab is drawn as a separate rounded, lifted container. */
+    public static boolean floatingTabsEnabled() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.FLAGS_FLOATING_TABS_ENABLED, true);
+    }
+
+    /** Whether tabs other than the selected one show their close button. */
+    public static boolean backgroundTabCloseEnabled() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.FLAGS_BACKGROUND_TAB_CLOSE_ENABLED, false);
+    }
+
+    /**
+     * Whether the strip and its unselected tabs are drawn darker than the toolbar. Only meaningful
+     * alongside floating tabs: without them the strip keeps its stock appearance, including the
+     * status bar above it.
+     */
+    public static boolean darkTabStripEnabled() {
+        return floatingTabsEnabled()
+                && ChromeSharedPreferences.getInstance()
+                        .readBoolean(ChromePreferenceKeys.FLAGS_DARK_TAB_STRIP_ENABLED, false);
+    }
+
+    /**
+     * The colour shared by the strip background and its unselected tabs: the toolbar's own
+     * background, i.e. what the address bar sits in.
+     */
+    public static @ColorInt int getDarkStripColor(Context context, boolean isIncognito) {
+        return ChromeColors.getDefaultThemeColor(context, isIncognito);
+    }
+
+    /**
+     * The colour of the selected tab: the address bar pill itself, so the active tab reads as the
+     * same surface as the omnibox.
+     */
+    public static @ColorInt int getSelectedTabColor(Context context, boolean isIncognito) {
+        return ThemeUtils.getTextBoxColorForToolbarBackgroundInNonNativePage(
+                context,
+                ChromeColors.getDefaultThemeColor(context, isIncognito),
+                isIncognito,
+                /* isCustomTab= */ false);
+    }
+}
