+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/fingerprinting_noise.h"
+
+#include <bit>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/no_destructor.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "components/ungoogled/ungoogled_switches.h"
+#include "crypto/hmac.h"
+
+namespace blink {
+
+namespace {
+
+constinit thread_local FingerprintingNoise::ScopedSeed* g_current_seed =
+    nullptr;
+
+// The key the browser passed, or nullopt when it passed none.
+const std::optional<std::vector<uint8_t>>& Key() {
+  static const base::NoDestructor<std::optional<std::vector<uint8_t>>> key(
+      []() -> std::optional<std::vector<uint8_t>> {
+        std::vector<uint8_t> bytes;
+        if (!base::HexStringToBytes(
+                base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+                    switches::kFingerprintingNoiseKey),
+                &bytes) ||
+            bytes.empty()) {
+          return std::nullopt;
+        }
+        return bytes;
+      }());
+  return *key;
+}
+
+}  // namespace
+
+FingerprintingNoise::ScopedSeed::ScopedSeed(const String& site) {
+  const std::optional<std::vector<uint8_t>>& key = Key();
+  if (!key) {
+    return;
+  }
+  const std::string site_utf8 = site.Utf8();
+  const auto seed =
+      crypto::hmac::SignSha256(*key, base::as_byte_span(site_utf8));
+  auto words = base::span(seed);
+  for (size_t i = 0; i < state_.size(); ++i) {
+    state_[i] = base::U64FromLittleEndian(words.subspan(i * 8).first<8>());
+  }
+  if (state_ == std::array<uint64_t, 4>{}) {
+    state_[0] = 1;  // An all-zero state would only ever yield zeros.
+  }
+  active_ = true;
+  previous_ = g_current_seed;
+  g_current_seed = this;
+}
+
+FingerprintingNoise::ScopedSeed::~ScopedSeed() {
+  if (active_) {
+    g_current_seed = previous_;
+  }
+}
+
+// xoshiro256**
+uint64_t FingerprintingNoise::ScopedSeed::Next() {
+  const uint64_t result = std::rotl(state_[1] * 5, 7) * 9;
+  const uint64_t t = state_[1] << 17;
+  state_[2] ^= state_[0];
+  state_[3] ^= state_[1];
+  state_[1] ^= state_[2];
+  state_[0] ^= state_[3];
+  state_[2] ^= t;
+  state_[3] = std::rotl(state_[3], 45);
+  return result;
+}
+
+// static
+double FingerprintingNoise::RandDouble() {
+  if (!g_current_seed) {
+    return base::RandDouble();
+  }
+  return (g_current_seed->Next() >> 11) * 0x1.0p-53;
+}
+
+// static
+int FingerprintingNoise::RandIntInclusive(int min, int max) {
+  if (!g_current_seed) {
+    return base::RandIntInclusive(min, max);
+  }
+  const uint64_t range = static_cast<uint64_t>(max - min) + 1;
+  return min + static_cast<int>(g_current_seed->Next() % range);
+}
+
+}  // namespace blink
