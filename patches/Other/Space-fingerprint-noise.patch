+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FINGERPRINTING_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FINGERPRINTING_NOISE_H_
+
+#include <array>
+#include <cstdint>
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/blink/renderer/platform/wtf/allocator/allocator.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+// Where the fingerprinting noise (canvas image data, client rects,
+// measureText) draws its randomness. The browser gives every renderer a key
+// that is random per browser run and different for each storage partition.
+// Inside a ScopedSeed the noise comes from that key and a site, so the site
+// sees the same noise until the browser restarts while other sites and other
+// isolated workspaces see different noise -- Brave's "farbling", salted per
+// container. Outside a scope, or without a key, it stays random.
+class PLATFORM_EXPORT FingerprintingNoise {
+  STATIC_ONLY(FingerprintingNoise);
+
+ public:
+  // Until destroyed, the noise drawn on this thread derives from `site`, a
+  // serialized top-level site.
+  class PLATFORM_EXPORT ScopedSeed {
+    STACK_ALLOCATED();
+
+   public:
+    explicit ScopedSeed(const String& site);
+    ScopedSeed(const ScopedSeed&) = delete;
+    ScopedSeed& operator=(const ScopedSeed&) = delete;
+    ~ScopedSeed();
+
+    uint64_t Next();
+
+   private:
+    bool active_ = false;
+    std::array<uint64_t, 4> state_ = {};
+    ScopedSeed* previous_ = nullptr;
+  };
+
+  // In [0, 1).
+  static double RandDouble();
+  // In [min, max].
+  static int RandIntInclusive(int min, int max);
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FINGERPRINTING_NOISE_H_
